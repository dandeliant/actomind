# ActoMind server configuration (copy to .env and fill in). Never commit the real .env.

# Port and interface
PORT=8080
HOST=0.0.0.0

# --- Google Cloud Text-to-Speech (choose ONE method) ---------------------------------
# 1) API key restricted to "Cloud Text-to-Speech API"
GOOGLE_TTS_API_KEY=

# 2) Service account JSON key file (path relative to the project folder or absolute)
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/actomind-tts.json

# 3) Service account JSON passed as an environment variable (handy on PaaS hosting)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}

# --- Protection ------------------------------------------------------------------------
# Strongly recommended when the server is reachable from the internet: the app must send this
# code (Settings → Google Cloud → Access code) before the server will call Google on your bill.
ACTOMIND_ACCESS_CODE=

# Allow a frontend hosted on another domain to call this backend (comma separated, or *)
# ALLOWED_ORIGINS=https://actomind.example.com

# --- Cache & limits --------------------------------------------------------------------
TTS_CACHE_DIR=server/.cache
TTS_CACHE_MAX_MB=500
# synthesis requests per 10 minutes per IP
TTS_RATE_LIMIT=600

# Development only: generate a test tone instead of calling Google (never use in production)
# ACTOMIND_TTS_MOCK=1
